{
  "name": "crewdeck-desktop",
  "version": "1.7.1",
  "private": true,
  "author": "CptSpaceDust",
  "description": "The private desktop home for the CrewDeck community.",
  "main": "src/main.js",
  "scripts": {
    "start": "npm run build:renderer && electron .",
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron . --dev\"",
    "build:renderer": "vite build",
    "test": "node --test tests/*.test.js",
    "pack": "npm run build:renderer && electron-builder --dir",
    "build:installer-ui": "powershell -NoProfile -NonInteractive -File build/build-installer-ui.ps1",
    "dist": "npm run build:renderer && npm run build:installer-ui && electron-builder --win nsis"
  },
  "dependencies": {
    "@hcaptcha/react-hcaptcha": "^1.12.1",
    "@supabase/supabase-js": "2.57.4",
    "electron-updater": "6.8.9",
    "livekit-client": "2.22.3",
    "lucide-react": "0.468.0",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "4.3.4",
    "concurrently": "9.2.5",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "prettier": "3.6.2",
    "source-map-js": "1.2.2",
    "vite": "6.4.3",
    "wait-on": "8.0.3"
  },
  "build": {
    "appId": "com.crewdeck.app",
    "productName": "CrewDeck",
    "asar": true,
    "files": [
      "dist-renderer/**/*",
      "assets/**/*",
      "src/**/*",
      "package.json"
    ],
    "win": {
      "icon": "assets/icon.png",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "guid": "d7a6a953-56df-5b98-b299-c025a7d6ae7b",
      "include": "build/installer.nsh",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "CrewDeck",
      "installerSidebar": "build/installer-sidebar.bmp",
      "uninstallerSidebar": "build/installer-sidebar.bmp",
      "installerHeader": "build/installer-header.bmp",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "CptSpaceDust",
        "repo": "CrewDeck",
        "releaseType": "release"
      }
    ]
  },
  "overrides": {
    "@electron/get": "5.1.0"
  }
}
